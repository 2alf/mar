import MonsterCN.Rigidity

/-!
# MAR-2: the hidden symmetry σ

`σ = (16B 16C)(32A 32B)` commutes with every prime power map and preserves element orders and
centralizer orders, so power-map data cannot tell the two tables of MAR-1 apart. Only character
values separate them, e.g. `a₂(32A) = 4 ≠ 0 = a₂(32B)`.

Restated from `MonsterCN/Rigidity.lean`, where the proofs are.
Generated by `tools/gen_mar_files.py`.
-/

namespace MAR

open MonsterCN MonsterCN.RigDom

/-- `σ` is a symmetry of all group-order data; `a₂` separates `32A` from `32B`. -/
theorem MAR2 :
    (∀ c, c < 194 → ∀ p ∈ monsterPrimes, pw p (sigma c) = sigma (pw p c)) ∧
    (∀ c, c < 194 → ordOf (sigma c) = ordOf c ∧ centOf (sigma c) = centOf c) ∧
    (∀ c, c < 194 → twist c = cn (sigma c)) ∧
    coeff 2 106 = 4 ∧ coeff 2 107 = 0 ∧ coeff 1 106 = coeff 1 107 :=
  MonsterCN.sigma_automorphism

end MAR
