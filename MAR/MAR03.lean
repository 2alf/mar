import MonsterCN.Rigidity

/-!
# MAR-3: uniqueness given the catalogue

With the 171-group catalogue, the Conway–Norton table is the only compatible labelling that is
(a) surjective and satisfies `a₂`-vanishing, or (b) satisfies `a₂`-vanishing and `a₁`-coherence.

Restated from `MonsterCN/Rigidity.lean`, where the proofs are.
Generated by `tools/gen_mar_files.py`.
-/

namespace MAR

open MonsterCN MonsterCN.RigDom

/-- Compatible + surjective + `a₂`-vanishing ⇒ `cn`. -/
theorem MAR3_surj {L : Nat → CNLabel} (hC : Compat L) (hS : Surj L)
    (hV : Van [2] L) : ∀ c, c < 194 → L c = cn c :=
  MonsterCN.unique_of_surj_van hC hS hV

/-- Compatible + `a₂`-vanishing + `a₁`-coherence ⇒ `cn`. -/
theorem MAR3_coh {L : Nat → CNLabel} (hC : Compat L) (hV : Van [2] L)
    (hCoh : Coh [1] L) : ∀ c, c < 194 → L c = cn c :=
  MonsterCN.unique_of_van_coh hC hV hCoh

end MAR
