import MonsterCN.Rigidity

/-!
# MAR-5: exactly eight compatible tables

Without surjectivity or coefficient data, exactly 8 labellings by the catalogue are compatible
with the power maps. They come from three independent binary choices
(`variant b₁ b₂ b₃`), and they are pairwise distinct.

Restated from `MonsterCN/Rigidity.lean`, where the proofs are.
Generated by `tools/gen_mar_files.py`.
-/

namespace MAR

open MonsterCN MonsterCN.RigDom

/-- Compatible ⇔ one of the eight variants. -/
theorem MAR5 (L : Nat → CNLabel) :
    Compat L ↔ ∃ b₁ b₂ b₃ : Bool, ∀ c, c < 194 → L c = variant b₁ b₂ b₃ c :=
  MonsterCN.compat_iff_variant L

/-- The eight variants are distinct. -/
theorem MAR5_distinct : ∀ b₁ b₂ b₃ b₁' b₂' b₃' : Bool,
    (variant b₁ b₂ b₃ 54 = variant b₁' b₂' b₃' 54 ∧ variant b₁ b₂ b₃ 55 = variant b₁' b₂' b₃' 55 ∧
      variant b₁ b₂ b₃ 61 = variant b₁' b₂' b₃' 61) → b₁ = b₁' ∧ b₂ = b₂' ∧ b₃ = b₃' :=
  MonsterCN.variant_injective

end MAR
