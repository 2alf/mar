import MonsterCN.Automorphisms

/-!
# MAR-6: the power-map symmetries of the Monster

Every permutation of the classes that preserves element orders and commutes with the 15 prime
power maps moves classes only within 24 explicit pairs: the 22 Galois-conjugate pairs (on which
characters and moonshine labels agree) and the two pairs of `σ` (on which they do not).

Restated from `MonsterCN/Automorphisms.lean`, where the proofs are.
Generated by `tools/gen_mar_files.py`.
-/

namespace MAR

open MonsterCN

/-- Every power-map symmetry fixes a class or swaps it with its partner. -/
theorem MAR6 {π : Nat → Nat} (h : IsPowerAut π) :
    ∀ c, c < 194 → π c = c ∨ π c = partner c :=
  MonsterCN.powerAut_classification h

/-- On the 22 Galois pairs, characters, centralizers and labels agree. -/
theorem MAR6_galois :
    galoisPairs.length = 22 ∧
    galoisPairs.all (fun q => chi2.getD q.1 0 == chi2.getD q.2 0 &&
      chi3.getD q.1 0 == chi3.getD q.2 0 && chi4.getD q.1 0 == chi4.getD q.2 0 &&
      centOf q.1 == centOf q.2 && cn q.1 == cn q.2) = true :=
  MonsterCN.galois_pairs_invisible

/-- On the two pairs of `σ`, characters differ. -/
theorem MAR6_sigma :
    centOf 54 = centOf 55 ∧ chi2.getD 54 0 = -1 ∧ chi2.getD 55 0 = 7 ∧
    centOf 106 = centOf 107 ∧ chi3.getD 106 0 = 2 ∧ chi3.getD 107 0 = -2 :=
  MonsterCN.sigma_pairs_visible

end MAR
