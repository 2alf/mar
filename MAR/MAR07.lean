import MonsterCN.Automorphisms
import MonsterCN.Supplement

/-!
# MAR-7: no power-map rule gives the thread at 32A and 32B

Any function of the classes that is invariant under power-map symmetries (as is anything
computed from power maps and element orders) differs from the Conway–Norton thread `h` at `32A`
(`h = 1`) or at `32B` (`h = 2`). This explains one exception in Le Bruyn's reconstruction.

Restated from `MonsterCN/Automorphisms.lean`, `MonsterCN/Supplement.lean`, where the proofs are.
Generated by `tools/gen_mar_files.py`.
-/

namespace MAR

open MonsterCN MonsterCN.GZ

/-- No power-map-invariant rule computes the thread `h` at both `32A` and `32B`. -/
theorem MAR7 (F : Nat → Nat)
    (hF : ∀ π, IsPowerAut π → ∀ c, c < 194 → F (π c) = F c) :
    F 106 ≠ (cn 106).h ∨ F 107 ≠ (cn 107).h :=
  MonsterCN.no_invariant_h_rule F hF

/-- Strong form: invariance under `σ` alone suffices (covers rules using centralizer orders too). -/
theorem MAR7_sigma (F : Nat → Nat) (hF : ∀ c, c < 194 → F (sigma c) = F c) :
    F 106 ≠ (cn 106).h ∨ F 107 ≠ (cn 107).h :=
  MonsterCN.no_sigma_invariant_h_rule F hF

end MAR
