import MonsterCN.Automorphisms

/-!
# MAR-8: with the catalogue, the thread is determined except at 32A, 32B

Every compatible labelling by the catalogue has the Conway–Norton thread `h` at every class except
`32A` and `32B`, and both values occur there. (Also: Le Bruyn's rule, evaluated on the ATLAS data,
fails at exactly 14 classes; this is a check of known work, not a new result.)

Restated from `MonsterCN/Automorphisms.lean`, where the proofs are.
Generated by `tools/gen_mar_files.py`.
-/

namespace MAR

open MonsterCN

/-- The thread is forced away from `32A`, `32B`. -/
theorem MAR8 (L : Nat → CNLabel) (hL : Compat L) :
    ∀ c, c < 194 → c ≠ 106 → c ≠ 107 → (L c).h = (cn c).h :=
  MonsterCN.thread_determined_by_compat L hL

/-- Both thread values occur at `32A`. -/
theorem MAR8_both :
    (variant true false false 106).h = 2 ∧ (cn 106).h = 1 :=
  MonsterCN.thread_ambiguous_at_32

/-- Le Bruyn's rule (arXiv:1804.04127, Thm 2) fails at exactly these 14 classes. -/
theorem LeBruyn_check :
    (classes.filter fun c => lbThread c != (cn c).h).map nameOf =
      ["8B", "8D", "16A", "24A", "24D", "24E", "24H", "32B", "40B", "40C", "40D", "48A",
       "88A", "88B"] :=
  MonsterCN.lebruyn_exceptions

end MAR
