import MonsterCN.BabyMonster

/-!
# MAR-11: hidden symmetries of the Baby Monster

There are permutations of the 247 classes of `2·𝔹` that preserve element and centralizer orders
and commute with all power maps, yet exchange classes whose generalized moonshine functions
`T_{t,g}` differ: six pairs differ in `H₁ = 1 + χ₄₃₇₁`, two more in `H₂ = χ₉₆₂₅₆`.
External input (A3): Höhn's identification of `H₁`, `H₂`.

Restated from `MonsterCN/BabyMonster.lean`, where the proofs are.
Generated by `tools/gen_mar_files.py`.
-/

namespace MAR

open MonsterCN.Baby

/-- Six power-map symmetries moving classes with different `H₁`. -/
theorem MAR11_H1 : ∀ i, i < 6 →
    IsPowerAutB (permOf (wit i).2.2) ∧ permOf (wit i).2.2 (wit i).1 = (wit i).2.1 ∧
    (wit i).1 < 247 ∧ H1 (wit i).1 ≠ H1 (wit i).2.1 :=
  MonsterCN.Baby.hidden_moonshine_symmetries

/-- Two more, moving classes with different `H₂`. -/
theorem MAR11_H2 : ∀ i, i < 2 →
    IsPowerAutB (permOf (wit2 i).2.2) ∧ permOf (wit2 i).2.2 (wit2 i).1 = (wit2 i).2.1 ∧
    (wit2 i).1 < 247 ∧ H2 (wit2 i).1 ≠ H2 (wit2 i).2.1 :=
  MonsterCN.Baby.hidden_moonshine_symmetries₂

/-- The six pairs. -/
theorem MAR11_names :
    (witnesses.map fun w => (nameB w.1, nameB w.2.1)) =
      [("8C", "8D"), ("16A", "16B"), ("24B", "24C"), ("24D", "24E"), ("40B", "40C"),
       ("48A", "48B")] :=
  MonsterCN.Baby.witness_names

/-- Their `H₁` values. -/
theorem MAR11_values :
    (witnesses.map fun w => (H1 w.1, H1 w.2.1)) =
      [(8, -8), (4, -4), (-1, 1), (3, -3), (-2, 2), (1, -1)] :=
  MonsterCN.Baby.h1_values

/-- The other two pairs and `H₂`. -/
theorem MAR11_names₂ :
    (witnesses2.map fun w => (nameB w.1, nameB w.2.1, H2 w.1, H2 w.2.1)) =
      [("12X", "12Y", 6, -6), ("16H", "16I", 4, -4)] :=
  MonsterCN.Baby.witness2_names

end MAR
