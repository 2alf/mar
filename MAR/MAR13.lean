import MonsterCN.ConwayMoonshine
import MonsterCN.ConwayErratum

/-!
# MAR-13 (erratum): two wrong labels in the Conway-moonshine table

Duncan–Mack-Crane (Forum Math. Sigma 3 (2015) e10), Table A.1, gives one group to classes with
different series: `12E` and `6M` are both labelled `12-`, and `30J` and `30K` are both labelled
`60+12,15,20`. Since a genus-zero group has only one normalized Hauptmodul, `12E` and `30J` are
mislabelled; their groups are `(24|2+12)^{↑1/4}` and `(60+12,15,20)^{↑1/2}`. This is an
erratum, not a discovery: the correct groups already appear in Kondo (1985). The finite
computations of the correction are below; the classical inputs C1–C4 (Newman, Ligozat, valence
formula, Euler) are stated in `MonsterCN/ConwayErratum.lean`.

Restated from `MonsterCN/ConwayMoonshine.lean`, `MonsterCN/ConwayErratum.lean`, where the proofs are.
Generated by `tools/gen_mar_files.py`.
-/

namespace MAR

open MonsterCN.Conway MonsterCN.Erratum

/-- The printed labels contradict the series. -/
theorem MAR13 :
    -- 12E and 6M (also 6N) carry the same label 12- ...
    nameC 73 = "12E" ∧ nameC 37 = "6M" ∧ nameC 38 = "6N" ∧
    labC 73 = "12-" ∧ labC 37 = "12-" ∧ labC 38 = "12-" ∧
    -- ... but their series differ in the q-coefficient
    a1 73 = -2 ∧ a1 37 = 2 ∧ a1 38 = 2 ∧
    -- the Gamma0(12) Hauptmodul is the Monster series T_{12I} (CN label 12-), with a1 = 2
    MonsterCN.nameOf 42 = "12I" ∧ MonsterCN.cn 42 = ⟨12, 1, [1]⟩ ∧ MonsterCN.coeff 1 42 = 2 ∧
    -- 30J and 30K carry the same label 60+12,15,20 ...
    nameC 150 = "30J" ∧ nameC 151 = "30K" ∧
    labC 150 = "60+12,15,20" ∧ labC 151 = "60+12,15,20" ∧
    -- ... but differ in the q²-coefficient
    a2 150 = -1 ∧ a2 151 = 1 ∧
    -- the Hauptmodul of 60+12,15,20 is T_{60D}, with a2 = 1
    MonsterCN.nameOf 156 = "60D" ∧ MonsterCN.cn 156 = ⟨60, 1, [1, 12, 15, 20]⟩ ∧
    MonsterCN.coeff 2 156 = 1 :=
  MonsterCN.Conway.dmc_label_inconsistency

/-- `12E` matches `12L`, and `30J` matches `30G`, in `a₁` and `a₂`. -/
theorem MAR13_evidence :
    nameC 81 = "12L" ∧ a1 73 = a1 81 ∧ a2 73 = a2 81 ∧
    nameC 145 = "30G" ∧ a1 150 = a1 145 ∧ a2 150 = a2 145 :=
  MonsterCN.Conway.dmc_corrected_label_evidence

/-- Finite data for the exact identities `T_{12E} = T_{12L} = T_{12M}`, `T_{30J} = T_{30G}`. -/
theorem MAR13_identities :
    newmanOK (r 73) 24 = true ∧ newmanOK (r 81) 24 = true ∧ newmanOK (r 82) 24 = true ∧
    (divs 24).all (fun d => ordInt (r 73) 24 d && ordInt (r 81) 24 d && ordInt (r 82) 24 d) = true ∧
    ord (r 73) 24 24 = -1 ∧ ord (r 81) 24 24 = -1 ∧ ord (r 82) 24 24 = -1 ∧
    poleBound (r 73) (r 81) 24 = 1 ∧ poleBound (r 73) (r 82) 24 = 1 ∧
    seriesAgree 5 (r 73) (r 81) (chiOf 73) (chiOf 81) 48 = true ∧
    seriesAgree 5 (r 73) (r 82) (chiOf 73) (chiOf 82) 48 = true ∧
    newmanOK (r 145) 60 = true ∧
    (divs 60).all (fun d => ordInt (r 150) 60 d && ordInt (r 145) 60 d) = true ∧
    ord (r 150) 60 60 = -1 ∧ ord (r 145) 60 60 = -1 ∧
    poleBound (r 150) (r 145) 60 = 3 ∧
    seriesAgree 7 (r 150) (r 145) (chiOf 150) (chiOf 145) 120 = true :=
  MonsterCN.Erratum.identities_12E_30J

/-- `T_{30J}` is the `q ↦ -q` twist of `T_{30K}`. -/
theorem MAR13_twist :
    sameExp (twistMinus (r 151)) (r 150) 240 = true ∧ chiOf 150 = 0 ∧ chiOf 151 = 0 ∧
    newmanOK (r 150) 60 = true ∧ newmanOK (r 151) 60 = true :=
  MonsterCN.Erratum.identity_30J_30K

/-- Finite data showing the group of `30K` is exactly `60+12,15,20`. -/
theorem MAR13_group30 :
    isAL 60 12 W12 = true ∧ isAL 60 15 W15 = true ∧ isAL 60 20 W20 = true ∧
    divInv (r 151) 60 W12 = true ∧ divInv (r 151) 60 W15 = true ∧ divInv (r 151) 60 W20 = true ∧
    isAL 60 15 E15 = true ∧ elliptic E15 = true ∧ isAL 60 20 E20 = true ∧ elliptic E20 = true ∧
    sameCoset 60 (prim (mm W15 W20)) W12 = true ∧
    closedTable 60 K60 [W12, W15, W20] = true ∧
    (divs 60).all (fun d => ordInt (r 151) 60 d) = true ∧ degree (r 151) 60 = 4 :=
  MonsterCN.Erratum.group_30K

/-- Finite data showing the group of `12E` is exactly `(24|2+12)^{↑1/4}`. -/
theorem MAR13_group12 :
    -- G is an eta quotient of Newman level 48, with all δ even (so G ∈ q⁻¹ℤ[[q²]], G(τ+½) = −G(τ))
    chiOf 73 = 0 ∧ (keys (r 73) 48).all (fun δ => δ % 2 == 0) = true ∧
    newmanOK rG 48 = true ∧ (keys rG 200).all (fun δ => δ % 2 == 0) = true ∧
    (divs 48).all (fun d => ordInt rG 48 d) = true ∧
    -- Fricke invariance: divisor invariance (C2, C3) and an elliptic element in the coset
    divInv rG 48 Wf = true ∧ isAL 48 48 Ef = true ∧ elliptic Ef = true ∧
    -- L = W T_{-1/2} W^{-1} mod Γ₀(48), so λ(L) = λ(T)^{-1} = −1
    sameCoset 48 (prim (mm (mm Wf (2, -1, 0, 2)) (adj Wf))) Lm = true ∧
    -- coset table of Γ₀(24|2)+12 modulo Γ₀(48): 8 cosets, λ a homomorphism, kernel of size 4
    closedTable 48 K48 [T2, Lm, Wf] = true ∧
    (K48.all fun g => [(T2, (-1 : Int)), (Lm, -1), (Wf, 1)].all fun s =>
      lamOf (mm g s.1) == lamOf g * s.2) = true ∧
    (lam.filter (· == 1)).length = 4 ∧
    degree rG 48 = 4 :=
  MonsterCN.Erratum.group_12E

end MAR
