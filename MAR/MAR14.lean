import MonsterCN.ConwayMoonshine

/-!
# MAR-14: hidden symmetries of Co₀

Power-map symmetries of `Co₀` (preserving element and centralizer orders) exchange 6 pairs of
classes with different Conway-moonshine series, so no power-map rule recovers Conway moonshine.

Restated from `MonsterCN/ConwayMoonshine.lean`, where the proofs are.
Generated by `tools/gen_mar_files.py`.
-/

namespace MAR

open MonsterCN.Conway

/-- Six power-map symmetries moving classes with different series. -/
theorem MAR14 : ∀ i, i < 6 →
    IsPowerAutC (permOfC (witC i).2.2) ∧ permOfC (witC i).2.2 (witC i).1 = (witC i).2.1 ∧
    (witC i).1 < 167 ∧
    (a1 (witC i).1 ≠ a1 (witC i).2.1 ∨ a2 (witC i).1 ≠ a2 (witC i).2.1) :=
  MonsterCN.Conway.conway_hidden_symmetries

/-- No power-map-invariant rule reproduces `(a₁, a₂)`. -/
theorem MAR14_no_rule (F : Nat → Int × Int)
    (hF : ∀ π, IsPowerAutC π → ∀ c, c < 167 → F (π c) = F c) :
    ∃ c, c < 167 ∧ F c ≠ (a1 c, a2 c) :=
  MonsterCN.Conway.no_invariant_conway_rule F hF

/-- The six pairs. -/
theorem MAR14_names :
    (coWitnesses.map fun w => (nameC w.1, nameC w.2.1)) =
      [("9B", "9C"), ("18B", "18C"), ("12Q", "12R"), ("16B", "16C"), ("18F", "18H"),
       ("18G", "18I")] :=
  MonsterCN.Conway.conway_witness_names

end MAR
