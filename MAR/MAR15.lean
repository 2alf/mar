/-!
# MAR-15: Conway moonshine is not rigid

On the 29 odd-order classes of `Co₀`, the MAR-9 hypotheses (genus-zero labels of level `2·o(g)`,
the power rule, vanishing of all coefficients to `q³⁹`, coherence of whole series) admit
**exactly 12** labellings. They agree with the published table except at `9A, 9B, 9C`, and the
published table is one of them. The series are kernel-certified for all 29 classes against their
frame shapes (`MAR15_rows`).

Restated from `MonsterCN/ConwayOdd.lean`, `MonsterCN/ConwayOddCount.lean`, `MonsterCN/ConwayOddRows.lean`, where the proofs are.
Generated by `tools/gen_mar_files.py`.
-/

namespace MAR

open MonsterCN.ConwayOdd MonsterCN MonsterCN.Conway MonsterCN.GZ

/-- Exactly 12 admissible labellings (verified exhaustive search). -/
theorem MAR15 :
    (∀ L : Nat → CNLabel, admissible L = true →
      ∃ t ∈ oddTriples, ∀ c ∈ oddClasses, L c = oddSol t c) ∧
    (∀ t ∈ oddTriples, admissible (oddSol t) = true) ∧
    oddTriples.length = 12 ∧ oddTriples.Nodup :=
  MonsterCN.ConwayOdd.conway_exactly_12

/-- In particular the published labelling and the one with `9B ↦ 18|3` both pass. -/
theorem MAR15_two :
    admissible dmcOdd = true ∧ admissible altOdd = true ∧ altOdd 56 ≠ dmcOdd 56 :=
  MonsterCN.ConwayOdd.conway_not_rigid

/-- The 12 are distinct, and the published labelling is one of them. -/
theorem MAR15_published : oddTriples.length = 12 ∧ oddTriples.Nodup ∧
    (dmcOdd 54, dmcOdd 56, dmcOdd 58) ∈ oddTriples :=
  MonsterCN.ConwayOdd.oddTriples_spec

/-- All 29 series rows are certified against their frame shapes. -/
theorem MAR15_rows : ∀ c ∈ oddClasses, rowOK c = true :=
  MonsterCN.ConwayOdd.rows_all_certified

/-- Class names and the published label of `9B`. -/
theorem MAR15_names :
    nameC 54 = "9A" ∧ nameC 56 = "9B" ∧ nameC 58 = "9C" ∧ dmcOdd 56 = ⟨18, 1, [1]⟩ ∧
    labC 56 = "18-" :=
  MonsterCN.ConwayOdd.names_9

end MAR
