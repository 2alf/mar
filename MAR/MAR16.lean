import MonsterCN.ConwayPowers

/-!
# MAR-16: no squaring rule in Conway moonshine

In Conway moonshine the group of `g²` is not a function of the group of `g`: there are 8 pairs of
classes with the same order, the same series (certified to `q³⁹`) and the same group, whose
squares have different groups. At odd primes, and in the Monster at every prime, the group of
`g^p` is a function of the group of `g`.

Restated from `MonsterCN/ConwayPowers.lean`, where the proofs are.
Generated by `tools/gen_mar_files.py`.
-/

namespace MAR

open MonsterCN.ConwayPowers MonsterCN MonsterCN.Conway MonsterCN.ConwayOdd

/-- The eight pairs. -/
theorem MAR16 :
    pairs.all (fun x =>
      ordC x.1 == ordC x.2 && serP x.1 == serP x.2 && corrLabel x.1 == corrLabel x.2 &&
      coChi276.getD (pwC 2 x.1) 0 != coChi276.getD (pwC 2 x.2) 0 &&
      corrLabel (pwC 2 x.1) != corrLabel (pwC 2 x.2)) = true :=
  MonsterCN.ConwayPowers.conway_not_functorial_at_2

/-- No map on group labels describes squaring. -/
theorem MAR16_no_rule :
    ¬ ∃ R : String → String, ∀ c, c < 167 → corrLabel (pwC 2 c) = R (corrLabel c) :=
  MonsterCN.ConwayPowers.no_label_squaring_rule

/-- Contrast: at odd primes such a map exists. -/
theorem MAR16_odd :
    allC.all (fun c => allC.all fun d =>
      corrLabel c != corrLabel d ||
      coPrimes.all fun p => p == 2 || corrLabel (pwC p c) == corrLabel (pwC p d)) = true :=
  MonsterCN.ConwayPowers.conway_functorial_odd

/-- Contrast: in the Monster it exists at every prime. -/
theorem MAR16_monster :
    (List.range 194).all (fun c => (List.range 194).all fun d =>
      cn c != cn d || monsterPrimes.all fun p => cn (pw p c) == cn (pw p d)) = true :=
  MonsterCN.ConwayPowers.monster_functorial

/-- The pairs and their squares. -/
theorem MAR16_names :
    (pairs.map fun x => (nameC x.1, nameC x.2, nameC (pwC 2 x.1), nameC (pwC 2 x.2))) =
      [("6E", "6J", "3A", "3C"), ("6F", "6I", "3A", "3C"), ("10D", "10I", "5A", "5C"),
       ("10E", "10H", "5A", "5C"), ("18D", "18G", "9A", "9B"), ("18E", "18F", "9A", "9B"),
       ("30F", "30K", "15A", "15E"), ("30G", "30J", "15A", "15E")] :=
  MonsterCN.ConwayPowers.pair_names

end MAR
