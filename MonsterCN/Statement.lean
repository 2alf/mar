/-
# Statement of the Conway–Norton table theorem

This file **states** (it does not prove) the "Conway–Norton table theorem" of monstrous
moonshine — for every element `g` of the Monster, the McKay–Thompson series `T_g` is the
normalized Hauptmodul of the genus-zero group `Γ_g = n|h + e, f, …` listed in Conway–Norton's
Table 2 (here: `MonsterCN.cn`, transcribed in `MonsterCN.Data.CNTable`) — as a precise Lean
proposition `ConwayNortonTable M`, relative to an abstract interface `MoonshineModel`.

Nothing here is assumed: there is no `axiom`, `sorry` or `admit`. The theorems proved are
bookkeeping (that `fixGroup` is a subgroup, and that `ConwayNortonTable` implies the weaker
existential form `ConwayNortonTableExistential`) and the well-definedness lemma `cn_invariant`
(derived from the rigidity theorem of `MonsterCN.Rigidity`).

References.
* J. H. Conway, S. P. Norton, *Monstrous Moonshine*, Bull. LMS 11 (1979), 308–339, §3 and Table 2.
* R. E. Borcherds, *Monstrous moonshine and monstrous Lie superalgebras*, Invent. Math. 109 (1992).
* Duncan–Griffin–Ono, *Moonshine*, Res. Math. Sci. 2 (2015), Appendix A (source of the table).
-/
import Mathlib
import MonsterCN.Basic
import MonsterCN.Rigidity

open Matrix Matrix.SpecialLinearGroup UpperHalfPlane Filter Topology
open scoped Manifold MatrixGroups

noncomputable section

namespace MonsterCN

/-! ## Normalized Hauptmoduln -/

/-- The embedding `SL₂(ℤ) → SL₂(ℝ)`. -/
abbrev toR : SL(2, ℤ) →* SL(2, ℝ) := Matrix.SpecialLinearGroup.map (Int.castRingHom ℝ)

/-- **Normalized Hauptmodul.** `IsNormalizedHauptmodul Γ f` says:

* (a) `f` is holomorphic on `ℍ`;
* (b) `f` is `Γ`-invariant: `f (γ • τ) = f τ` for `γ ∈ Γ` (Möbius action of `SL₂(ℝ)` on `ℍ`);
* (c) `f` is normalized at the cusp `∞`: `f τ - e^{-2πiτ} → 0` as `Im τ → ∞`, i.e. the
  `q`-expansion is `q⁻¹ + 0 + O(q)`;
* (d) `f` is holomorphic at every cusp of `Γ` other than (the `Γ`-class of) `∞`: for every
  `γ ∈ SL₂(ℤ)` (so that `γ • ∞` runs over all of `ℚ ∪ {∞}`), either `γ • ∞` is `Γ`-equivalent
  to `∞` — expressed as `∃ δ ∈ Γ` with `δ γ` upper triangular, i.e. `(δγ) • ∞ = ∞` — or
  `f ∘ γ` is bounded as `Im τ → ∞` (uniformly in `Re τ`, Mathlib's `IsBoundedAtImInfty`);
* (e) `f` is injective on `Γ \ ℍ`: `f τ = f τ'` implies `τ' ∈ Γ • τ`.

For `Γ ≤ SL₂(ℝ)` commensurable with `SL₂(ℤ)` (the only case of interest; e.g. `Γ ⊇ Γ₀(N)`
with `f` non-constant forces this), (a)–(e) say exactly that `f` induces a holomorphic map
`X(Γ) → ℙ¹` whose only pole is a simple pole at the cusp `∞` and which is injective on `Y(Γ)`.
Such a map has degree equal to its pole order; injectivity on the cofinite set `Y(Γ)` forces
degree `1`, so `f : X(Γ) ≅ ℙ¹`. Hence (a)–(e) ⟺ "`X(Γ)` has genus zero and `f` is its
normalized Hauptmodul" in the sense of Conway–Norton (1979), §3. (Condition (c) together with
(b) also forces every translation in `Γ` to be integral, and degree `1` forces the cusp width
at `∞` to be `1`.)

Boundedness in (d) suffices for holomorphy at the cusp by Riemann's removable-singularity
theorem, since `f ∘ γ` is periodic for `Γ` commensurable with `SL₂(ℤ)`.

Note: the AxiomMath/LeanVOA development uses an analytic variant of this definition with eight
conditions; it is equivalent for the groups considered here, but that equivalence is not proved
in this project. -/
def IsNormalizedHauptmodul (Γ : Subgroup SL(2, ℝ)) (f : ℍ → ℂ) : Prop :=
  -- (a) holomorphic on ℍ
  MDifferentiable 𝓘(ℂ) 𝓘(ℂ) f ∧
  -- (b) Γ-invariant
  (∀ γ ∈ Γ, ∀ τ : ℍ, f (γ • τ) = f τ) ∧
  -- (c) normalized at ∞: f = q⁻¹ + 0 + O(q)
  Tendsto (fun τ : ℍ => f τ - Complex.exp (-2 * Real.pi * Complex.I * (τ : ℂ))) atImInfty (𝓝 0) ∧
  -- (d) holomorphic at the cusps not Γ-equivalent to ∞
  (∀ γ : SL(2, ℤ), (∃ δ ∈ Γ, (δ * toR γ) 1 0 = 0) ∨
      IsBoundedAtImInfty (fun τ : ℍ => f (toR γ • τ))) ∧
  -- (e) injective on Γ \ ℍ
  (∀ τ τ' : ℍ, f τ = f τ' → ∃ γ ∈ Γ, τ' = γ • τ)

/-! ## The groups `Γ₀(n) + e, f, …` -/

/-- `Γ₀(N)` as a subgroup of `SL₂(ℝ)`: the image of Mathlib's `CongruenceSubgroup.Gamma0 N`. -/
def gamma0R (N : ℕ) : Subgroup SL(2, ℝ) := (CongruenceSubgroup.Gamma0 N).map toR

/-- The Atkin–Lehner coset `W_e` of `Γ₀(N)` (for an exact divisor `e ∥ N`): all matrices
`(1/√e) · [[a e, b], [c N, d e]]` with `a, b, c, d ∈ ℤ` and `a d e² - b c N = e`
(so determinant `1`). For `e = 1` this is `Γ₀(N)` itself. The definition makes sense for any
`e`; it is only used with `e` a Hall divisor of `N`, as in the table. -/
def atkinLehner (N e : ℕ) : Set SL(2, ℝ) :=
  {A | ∃ a b c d : ℤ, a * d * (e : ℤ) ^ 2 - b * c * N = e ∧
    A 0 0 = a * e / Real.sqrt e ∧ A 0 1 = b / Real.sqrt e ∧
    A 1 0 = c * N / Real.sqrt e ∧ A 1 1 = d * e / Real.sqrt e}

/-- The group `Γ₀(n) + W` generated by `Γ₀(n)` and the Atkin–Lehner involutions `W_e`, `e ∈ W`.
For a label `n|h+W` with `h = 1` this is exactly the Conway–Norton group `Γ_g`. (For `h > 1`
it is *not* the right group; see `ConwayNortonTable`.) -/
def cnGroup₁ (l : CNLabel) : Subgroup SL(2, ℝ) :=
  Subgroup.closure (↑(gamma0R l.n) ∪ ⋃ e ∈ l.W, atkinLehner l.n e)

/-- The full invariance group `{γ ∈ SL₂(ℝ) | f ∘ γ = f}` of a function on `ℍ`. -/
def fixGroup (f : ℍ → ℂ) : Subgroup SL(2, ℝ) where
  carrier := {γ | ∀ τ : ℍ, f (γ • τ) = f τ}
  one_mem' := fun τ => by simp
  mul_mem' := fun {a b} ha hb τ => by
    change f ((a * b) • τ) = f τ
    rw [mul_smul]
    exact (ha _).trans (hb τ)
  inv_mem' := fun {a} ha τ => by
    change f (a⁻¹ • τ) = f τ
    have h := ha (a⁻¹ • τ)
    rw [smul_inv_smul] at h
    exact h.symm

theorem mem_fixGroup {f : ℍ → ℂ} {γ : SL(2, ℝ)} : γ ∈ fixGroup f ↔ ∀ τ : ℍ, f (γ • τ) = f τ :=
  Iff.rfl

/-! ## The abstract moonshine model -/

/-- **Interface for a model of the Monster acting on the moonshine module.**

* `G` is a group (the Monster), with a class map `classOf : G → ℕ` onto the 194 ATLAS class
  indices `0, …, 193` (in the order of `MonsterCN.Data.Atlas`), compatible with the `p`-power
  maps for the Monster primes and with element orders;
* `T g : ℍ → ℂ` is the McKay–Thompson series of `g`.

Intended instance: the AxiomMath/LeanVOA construction of the Monster acting on `V♮`, with
`T g τ = Σₙ tr(g | V♮_{n+1}) qⁿ`, `q = e^{2πiτ}`. Constructing this instance — enumerating the
194 conjugacy classes of the Lean Monster model and matching them to the ATLAS names (via
`classOf`) — is the main open dependency; it is not done in this project.

The interface deliberately does not require `classOf` to be constant on conjugacy classes or
`T` to be a class function: the statement `ConwayNortonTable` is about each element `g`. -/
structure MoonshineModel where
  /-- The group (intended: the Monster). -/
  G : Type
  [instGroup : Group G]
  /-- ATLAS class index of an element. -/
  classOf : G → ℕ
  classOf_lt : ∀ g, classOf g < 194
  classOf_surj : ∀ c, c < 194 → ∃ g, classOf g = c
  classOf_pow : ∀ g, ∀ p ∈ monsterPrimes, classOf (g ^ p) = pw p (classOf g)
  orderOf_eq : ∀ g, orderOf g = ordOf (classOf g)
  /-- `traces m g` is intended to be `tr(g | V♮_{m+1})`, the `m`-th coefficient of `T_g`. -/
  traces : ℕ → G → ℤ
  /-- The class labelling matches the ATLAS character data on the first two coefficients.
  Without this field `classOf` would only be determined up to the automorphism
  `σ = (16B 16C)(32A 32B)` of the power-map data (`MonsterCN.sigma_automorphism`), and
  `ConwayNortonTable` would depend on that choice; with it, the labels `cn ∘ classOf` are
  independent of the choice (`MonsterCN.cn_invariant`). -/
  traces_eq : ∀ g, ∀ m ∈ [1, 2], traces m g = coeff m (classOf g)
  /-- The McKay–Thompson series of `g`. -/
  T : G → ℍ → ℂ

attribute [instance] MoonshineModel.instGroup

/-- **Well-definedness of the labels.** Any relabelling `π` of the 194 classes that commutes
with the power maps and preserves element orders and the coefficients `a₁, a₂` leaves the
Conway–Norton label unchanged: `cn ∘ π = cn`. So two admissible choices of `classOf` in
`MoonshineModel` that differ by such a `π` give the same `ConwayNortonTable` proposition.
Proof: `cn ∘ π` satisfies the hypotheses of the rigidity theorem
`MonsterCN.unique_of_van_coh`. -/
theorem cn_invariant (π : ℕ → ℕ) (hlt : ∀ c, c < 194 → π c < 194)
    (hpow : ∀ c, c < 194 → ∀ p ∈ monsterPrimes, π (pw p c) = pw p (π c))
    (hord : ∀ c, c < 194 → ordOf (π c) = ordOf c)
    (hco : ∀ c, c < 194 → ∀ m ∈ [1, 2], coeff m (π c) = coeff m c) :
    ∀ c, c < 194 → cn (π c) = cn c := by
  refine unique_of_van_coh (L := fun c => cn (π c)) ?_ ?_ ?_
  · intro c hc
    obtain ⟨h1, h2, h3⟩ := compat_cn (π c) (hlt c hc)
    refine ⟨h1, h2.trans (hord c hc), fun p hp => ?_⟩
    simp only [hpow c hc p hp]
    exact h3 p hp
  · intro c hc m hm hne
    have hm' : m ∈ [1, 2] := by simp at hm; simp [hm]
    rw [← hco c hc m hm']
    exact van_cn (π c) (hlt c hc) m (by simp at hm; simp [hm]) hne
  · intro c hc d hd he m hm
    have hm' : m ∈ [1, 2] := by simp at hm; simp [hm]
    rw [← hco c hc m hm', ← hco d hd m hm']
    exact coh_cn (π c) (hlt c hc) (π d) (hlt d hd) he m (by simp at hm; simp [hm])

/-! ## The theorem statements -/

/-- **The Conway–Norton table theorem** (Conway–Norton 1979 conjecture, Borcherds 1992), stated
against the table `cn`.

* For `g` whose label `cn (classOf g) = n|h+W` has `h = 1`: `T g` is the normalized Hauptmodul
  of `Γ₀(n) + W` (`cnGroup₁`). This is the full, faithful statement for these classes.
* For `g` with `h > 1`: `T g` is invariant under `Γ₀(n h)` (level `n·h`), has the eigen-character
  `T(τ + 1/h) = e^{-2πi/h} T(τ)` under the translation by `1/h`, and is a normalized Hauptmodul
  for its own full invariance group `fixGroup (T g)`.

**Fidelity caveat for `h > 1`.** The `h > 1` clause records only standard *necessary*
consequences of the Conway–Norton description. It does **not** identify `fixGroup (T g)` with the
Conway–Norton group `n|h+W` — the index-`h` subgroup of `Γ₀(n|h) + W` cut out by an order-`h`
character — and in particular does not pin down the Atkin–Lehner set `W` for these classes.
Stating that requires formalising that character; this is future work. (For `h = 1` the
statement is exact, and since a Hauptmodul is injective on `X(Γ)`, `fixGroup (T g)` then
equals `cnGroup₁` automatically.) -/
def ConwayNortonTable (M : MoonshineModel) : Prop :=
  (∀ g : M.G, (cn (M.classOf g)).h = 1 →
      IsNormalizedHauptmodul (cnGroup₁ (cn (M.classOf g))) (M.T g)) ∧
  (∀ g : M.G, 1 < (cn (M.classOf g)).h →
      let n := (cn (M.classOf g)).n
      let h := (cn (M.classOf g)).h
      (∀ γ ∈ gamma0R (n * h), ∀ τ : ℍ, M.T g (γ • τ) = M.T g τ) ∧
      (∀ τ : ℍ, M.T g ((1 / (h : ℝ)) +ᵥ τ) =
        Complex.exp (-2 * Real.pi * Complex.I / h) * M.T g τ) ∧
      IsNormalizedHauptmodul (fixGroup (M.T g)) (M.T g))

/-- **Existential (genus-zero) form**: every `T g` is the normalized Hauptmodul of *some* group
containing a congruence group `Γ₀(N)`, `N ≥ 1`. This is the shape of the moonshine statement
proved in AxiomMath/LeanVOA; it does not refer to the table. -/
def ConwayNortonTableExistential (M : MoonshineModel) : Prop :=
  ∀ g : M.G, ∃ Γ : Subgroup SL(2, ℝ),
    (∃ N : ℕ, 0 < N ∧ gamma0R N ≤ Γ) ∧ IsNormalizedHauptmodul Γ (M.T g)

/-! ## The table form implies the existential form -/

/-- Every level `n` in the table is positive (kernel-checked). -/
theorem cn_n_pos : ∀ c, c < 194 → 0 < (cn c).n := by decide +kernel

theorem gamma0R_le_cnGroup₁ (l : CNLabel) : gamma0R l.n ≤ cnGroup₁ l := fun _ hx =>
  Subgroup.subset_closure (Or.inl hx)

/-- `ConwayNortonTable` implies `ConwayNortonTableExistential`: take `Γ = Γ₀(n) + W` when
`h = 1`, and `Γ = fixGroup (T g) ⊇ Γ₀(n h)` when `h > 1`. -/
theorem ConwayNortonTable.existential {M : MoonshineModel} (H : ConwayNortonTable M) :
    ConwayNortonTableExistential M := by
  intro g
  have hn := cn_n_pos _ (M.classOf_lt g)
  rcases Nat.lt_or_ge 1 (cn (M.classOf g)).h with hh | hh
  · obtain ⟨hinv, -, hH⟩ := H.2 g hh
    exact ⟨_, ⟨_, Nat.mul_pos hn (by omega), fun γ hγ => hinv γ hγ⟩, hH⟩
  · rcases Nat.le_one_iff_eq_zero_or_eq_one.1 hh with h0 | h1
    · -- no label has `h = 0`
      exfalso
      have : ∀ c, c < 194 → 0 < (cn c).h := by decide +kernel
      have := this _ (M.classOf_lt g)
      omega
    · exact ⟨_, ⟨_, hn, gamma0R_le_cnGroup₁ _⟩, H.1 g h1⟩

end MonsterCN
