/-
Generator for `MonsterCN/Data/AutDomains.lean`. Run from the project root (after building
`MonsterCN.Automorphisms`):

    lake env lean provenance/lean/gen_aut_domains.lean

It evaluates the propagation domains of `Automorphisms.lean` with `#eval` and writes them as
literals. Nothing here is trusted: `Automorphisms.lean` proves every literal equal to the
corresponding propagation round with `decide +kernel`.
-/
import MonsterCN.Automorphisms

open MonsterCN

def showDom (D : List (List Nat)) : String :=
  "[\n" ++ ",\n".intercalate (D.map fun ls => "  " ++ toString ls) ++ "]"

#eval do
  let d1 := astep ainit; let d2 := astep d1; let d3 := astep d2
  let defs := [("autD1", "`astep ainit`", d1), ("autD2", "`astep autD1`", d2),
    ("autD3", "`astep autD2` (= `aiter 3 ainit`)", d3)]
  let body := defs.map fun (nm, doc, D) =>
    "/-- " ++ doc ++ " -/\ndef " ++ nm ++ " : List (List Nat) := " ++ showDom D ++ "\n"
  IO.FS.writeFile "MonsterCN/Data/AutDomains.lean" ("/-
# Propagation domains for `Automorphisms.lean` (AUTO-GENERATED)

Generated by `provenance/lean/gen_aut_domains.lean`. Each literal is proved equal to the propagation round
named in its docstring, by `decide +kernel`, in `MonsterCN/Automorphisms.lean`.
-/

namespace MonsterCN.AutDom
\n" ++ "\n".intercalate body ++ "\nend MonsterCN.AutDom\n")
  IO.println "wrote 3 domains"
