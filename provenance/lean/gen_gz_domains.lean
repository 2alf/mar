/-
Generator for `MonsterCN/Data/GZDomains.lean`. Run from the project root (after building
`MonsterCN.GenusZero`):

    lake env lean provenance/lean/gen_gz_domains.lean

It evaluates the propagation domains of `GenusZero.lean` (MAR-9) with `#eval` and writes them as
literals. Nothing here is trusted: `GenusZero.lean` proves every literal equal to the
corresponding propagation round with `decide +kernel`.
-/
import MonsterCN.GenusZero

open MonsterCN MonsterCN.GZ

def showLabel (l : CNLabel) : String :=
  "⟨" ++ toString l.n ++ ", " ++ toString l.h ++ ", " ++ toString l.W ++ "⟩"

def showDom (D : List (List CNLabel)) : String :=
  "[\n" ++ ",\n".intercalate (D.map fun ls => "  [" ++ ", ".intercalate (ls.map showLabel) ++ "]")
    ++ "]"

#eval do
  let d0 := gzInit [1, 2]
  let d1 := step [1] d0; let d2 := step [1] d1; let d3 := step [1] d2
  let defs := [("gzD0", "`gzInit [1, 2]`", d0), ("gzD1", "`step [1] gzD0`", d1),
    ("gzD2", "`step [1] gzD1`", d2), ("gzD3", "`step [1] gzD2`", d3)]
  let body := defs.map fun (nm, doc, D) =>
    "/-- " ++ doc ++ " -/\ndef " ++ nm ++ " : List (List CNLabel) := " ++ showDom D ++ "\n"
  IO.FS.writeFile "MonsterCN/Data/GZDomains.lean" ("/-
# Propagation domains for `GenusZero.lean` (AUTO-GENERATED)

Generated by `provenance/lean/gen_gz_domains.lean`. Each literal is proved equal to the propagation round
named in its docstring, by `decide +kernel`, in `MonsterCN/GenusZero.lean`.
-/
import MonsterCN.Data.CNTable

namespace MonsterCN.GZDom

open MonsterCN
\n" ++ "\n".intercalate body ++ "\nend MonsterCN.GZDom\n")
  IO.println "wrote 4 domains"
