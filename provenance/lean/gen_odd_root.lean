/-
Generator for `MonsterCN/Data/ConwayOddRoot.lean`: the domains `fixp 6 oInit` of the MAR-15
search (`MonsterCN/ConwayOddCount.lean`), as a literal. Run from the project root:

    lake env lean provenance/lean/gen_odd_root.lean

The literal is not trusted: `ConwayOddCount.lean` proves it equal to `fixp 6 oInit` in the kernel.
-/
import MonsterCN.ConwayOddCount

open MonsterCN MonsterCN.ConwayOdd

def showLabel (l : CNLabel) : String :=
  "⟨" ++ toString l.n ++ ", " ++ toString l.h ++ ", " ++ toString l.W ++ "⟩"

#eval do
  let D := fixp 6 oInit
  let body := "[\n" ++ ",\n".intercalate (D.map fun (ls : List CNLabel) =>
    "  [" ++ ", ".intercalate (ls.map showLabel) ++ "]") ++ "]"
  IO.FS.writeFile "MonsterCN/Data/ConwayOddRoot.lean" ("/-
# Root domains of the MAR-15 search (AUTO-GENERATED by `provenance/lean/gen_odd_root.lean`)

Proved equal to `fixp 6 oInit` in `MonsterCN/ConwayOddCount.lean` (`oddRoot_eq`).
-/
import MonsterCN.Data.CNTable

namespace MonsterCN.ConwayOdd

open MonsterCN

/-- `fixp 6 oInit`: the domains after propagation, before any case split. -/
def oddRoot : List (List CNLabel) := " ++ body ++ "

end MonsterCN.ConwayOdd
")
  IO.println s!"wrote {D.length} domains"
