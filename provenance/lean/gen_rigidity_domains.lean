/-
Generator for `MonsterCN/Data/RigidityDomains.lean`. Run from the project root (after building
`MonsterCN.Rigidity`):

    lake env lean provenance/lean/gen_rigidity_domains.lean

It evaluates the intermediate propagation domains of `Rigidity.lean` with `#eval` and writes them
as literals. Nothing here is trusted: `Rigidity.lean` proves every literal equal to the
corresponding propagation step with `decide +kernel`.
-/
import MonsterCN.Rigidity

open MonsterCN

def showLabel (l : CNLabel) : String :=
  "⟨" ++ toString l.n ++ ", " ++ toString l.h ++ ", " ++ toString l.W ++ "⟩"

def showDom (D : Dom) : String :=
  "[\n" ++ ",\n".intercalate (D.map fun ls => "  [" ++ ", ".intercalate (ls.map showLabel) ++ "]")
    ++ "]"

def fB (D : Dom) : Dom := surjStep (step [] D)

def doms : List (String × String × Dom) :=
  let a1 := step [1] (init [2]); let a2 := step [1] a1
  let b1 := fB (init [2]); let b2 := fB b1
  let s1 := fB (init []); let s2 := fB s1; let s3 := fB s2
  let e1 := step [] (init []); let e2 := step [] e1; let e3 := step [] e2; let e4 := step [] e3
  [("domA1", "`step [1] (init [2])`", a1), ("domA2", "`step [1] domA1`", a2),
   ("domB1", "`surjStep (step [] (init [2]))`", b1), ("domB2", "`surjStep (step [] domB1)`", b2),
   ("domS1", "`surjStep (step [] (init []))`", s1), ("domS2", "`surjStep (step [] domS1)`", s2),
   ("domS3", "`surjStep (step [] domS2)` (= `Dstar`)", s3),
   ("domE1", "`step [] (init [])`", e1), ("domE2", "`step [] domE1`", e2),
   ("domE3", "`step [] domE2`", e3), ("domE4", "`step [] domE3` (= `Ecompat`)", e4)]

def header : String := "/-
# Intermediate propagation domains for `Rigidity.lean` (AUTO-GENERATED)

Generated by `provenance/lean/gen_rigidity_domains.lean`. Each literal is proved equal to the propagation
step named in its docstring, by `decide +kernel`, in `MonsterCN/Rigidity.lean`. Splitting the
propagation into single kernel-checked rounds keeps the kernel's memory use low.
-/
import MonsterCN.Data.CNTable

namespace MonsterCN.RigDom

open MonsterCN
"

#eval do
  let body := doms.map fun (nm, doc, D) =>
    "/-- " ++ doc ++ " -/\ndef " ++ nm ++ " : List (List CNLabel) := " ++ showDom D ++ "\n"
  IO.FS.writeFile "MonsterCN/Data/RigidityDomains.lean"
    (header ++ "\n" ++ "\n".intercalate body ++ "\nend MonsterCN.RigDom\n")
  IO.println s!"wrote {doms.length} domains"
